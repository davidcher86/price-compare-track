{
  "name": "Ebay",
  "url": "https://www.ebay.com/sch/i.html?_nkw=logi",
  "loadSelector": ".srp-results.srp-list",
  "listIdentifier": ".s-item__wrapper",
  "brightDataSupport" : false,
  "hrefHost": "https://www.ebay.com",
  "extractArgs": [
    {
      "keyName": "name",
      "selector": "[role=\"heading\"]",
      "type": "text"
    },
    {
      "keyName": "price",
      "selector": ".s-item__price",
      "type": "price"
    },
    {
      "keyName": "image",
      "selector": ".s-item__wrapper img[src]",
      "type": "img"
    },
    {
      "keyName": "href",
      "selector": "a.s-item__link",
      "type": "href"
    }
  ]
}