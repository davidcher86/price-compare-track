{
  "name": "Amazon",
  "disableSec": false,
  "url": "https://www.amazon.com/s?k=logi",
  "loadSelector": "#search",
  "listIdentifier": ".puisg-row",
  "brightDataSupport" : true,
  "hrefHost": "https://www.amazon.com",
  "extractArgs": [
    {
      "keyName": "name",
      "selector": ".s-line-clamp-2",
      "type": "text"
    },
    {
      "keyName": "price",
      "selector": ".a-price .a-offscreen",
      "type": "price"
    },
    {
      "keyName": "image",
      "selector": ".s-image",
      "type": "img"
    },
    {
      "keyName": "href",
      "selector": "a.a-link-normal",
      "type": "href"
    }
  ]
}