{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "../../",
    "sourceMap": true,
    "outDir": "./functions/data-extractor/dist",
    "declaration": false,
    "noEmitOnError": true,
    "incremental": true,
    "noEmit": true,
    "paths": {
      "shared/*": ["../../../layers/aws-sdk/storage/nodejs/shared/*"],
      "@commons/*": ["commons/*"],
      "@shared-commons/*": ["../commons/*"]
    }
  },
  "include": ["../../commons/**/*.ts","./../*.ts","./*.ts","./../*.json","./*.json"],
  "exclude": []
}