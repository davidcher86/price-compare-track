{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "../../",
    "sourceMap": true,
    "outDir": "./functions/extract-data-dlq",
    "declaration": false,
    "noEmitOnError": true,
    "incremental": true,
    "noEmit": true,
    "paths": {
      "shared/*": ["../../../layers/aws-sdk/storage/nodejs/shared/*"],
      "@commons/*": ["commons/*"],
      "@shared-commons/*": ["../commons/*"]
    }
  },
  "include": ["./*.ts", "../../../../layers/**/*.ts", "./../*.ts", "../../commons/*.ts", "../../commons/**/*.ts"],
  "exclude": []
}