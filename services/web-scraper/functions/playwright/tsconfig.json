{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "../../",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": false,
    "noEmitOnError": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "paths": {
      "shared/*": ["../../../layers/aws-sdk/storage/nodejs/shared/*"],
      "@commons/*": ["commons/*"],
      "@shared-commons/*": ["../commons/*"]
    }
  },
  "include": ["./../*.ts","./*.ts"],
  "exclude": []
}