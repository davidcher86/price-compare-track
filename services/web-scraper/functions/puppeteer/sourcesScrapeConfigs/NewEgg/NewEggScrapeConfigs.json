{
  "name": "NewEgg",
  "url": "https://www.newegg.com/p/pl?d={query}",
  "disableSec": true,
  "loadSelector": ".list-wrap",
  "listIdentifier": ".item-cell",
  "brightDataSupport" : false,
  "extractArgs": [
    {
      "keyName": "name",
      "selector": ".item-title",
      "type": "text"
    },
    {
      "keyName": "link",
      "selector": ".item-open-box-italic",
      "type": "href"
    },
    {
      "keyName": "price",
      "selector": ".price-current",
      "type": "price"
    },
    {
      "keyName": "image",
      "selector": "img[alt]",
      "type": "src"
    }
  ]
}