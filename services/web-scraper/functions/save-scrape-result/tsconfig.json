{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "../../",
    "sourceMap": true,
    "outDir": "./functions/save-scrape-result/dist",
    "declaration": false,
    "noEmitOnError": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "shared/*": ["../../../layers/aws-sdk/storage/nodejs/shared/*"],
      "@commons/*": ["commons/*"],
      "@shared-commons/*": ["../commons/*"]
