{
  "name": "web-scraper",
  "version": "1.0.0",
  "description": "<!-- title: 'AWS NodeJS Example' description: 'This template demonstrates how to deploy a simple NodeJS function running on AWS Lambda using the Serverless Framework.' layout: Doc framework: v4 platform: AWS language: nodeJS priority: 1 authorLink: 'https://github.com/serverless' authorName: 'Serverless, Inc.' authorAvatar: 'https://avatars1.githubusercontent.com/u/13742415?s=200&v=4' -->",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "offline:web-scraper": "sls offline",
    "invoke:handle-scrape-request": "sls invoke local -f acceptRequest --stage prod --path functions/formScrape/mock-data/datamocklist2.json",
    "invoke:puppeteer-new": "sls invoke local -f scraper --path functions/puppeteer/mock-data/datamocksqs.json",
    "invoke:extract-data": "sls invoke local -f extract-data --path functions/data-extractor/mock-data/mocksqsmsg.json",
    "invoke:extract-data-dlq": "sls invoke local -f dlq-handler --path functions/extract-data-dlq/mock-data/mocksqsmsg.json",
    "invoke:save-extracted-data": "sls invoke local -f save-extracted-data --path functions/save-scrape-result/mock-data/mocksqsmsg.json",
    "invoke:playwright-new": "sls invoke local -f scrapePlaywright --path functions/playwright/datamocknewegg.json --debug"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.848.0",
    "@aws-sdk/client-secrets-manager": "^3.857.0",
    "@aws-sdk/client-sqs": "^3.848.0",
    "@aws-sdk/lib-dynamodb": "^3.850.0",
    "esbuild": "^0.25.5",
    "serverless": "^4.18.0",
    "serverless-dotenv-plugin": "^1.1.5",
    "serverless-esbuild": "^1.55.1",
    "serverless-offline": "^14.4.0",
    "serverless-secrets-plugin": "^0.1.0",
    "serverless-websockets-plugin": "^1.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0"
  }
}
