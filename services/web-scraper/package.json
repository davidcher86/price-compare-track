  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "invoke:handle-scrape-request": "sls invoke local -f acceptRequest --stage prod --path functions/formScrape/datamocklist2.json",
    "invoke:puppeteer-new": "sls invoke local -f scraper --path functions/puppeteer/datamocksqs.json",
    "invoke:extract-data": "sls invoke local -f extract-data --path functions/data-extractor/mocksqsmsg.json",
    "invoke:save-extracted-data": "sls invoke local -f save-extracted-data --path functions/save-scrape-result/mocksqsmsg.json",
    "invoke:playwright-new": "sls invoke local -f scrapePlaywright --path functions/playwright/datamocknewegg.json --debug"
  },
