{
  "name": "Banggood",
  "disableSec": false,
  "url": "https://m.banggood.com/search/{query}.html?currency=USD",
  "loadSelector": ".product-list",
  "listIdentifier": ".product-list ul li",
  "singleItemPageLoadSelector": "#product-details",
  "singleItemPagePriceTag": "#product-details",
  "hrefHost": "https://m.banggood.com",
  "extractArgs": [
    {
      "keyName": "name",
      "selector": ".info-box p.name",
      "type": "text"
    },
    {
      "keyName": "price",
      "selector": ".info .price",
      "type": "price"
    },
    {
      "keyName": "image",
      "selector": ".img-div img, .img-box img",
      "type": "img"
    },
    {
      "keyName": "href",
      "selector": "a",
      "type": "href"
    }
  ]
}