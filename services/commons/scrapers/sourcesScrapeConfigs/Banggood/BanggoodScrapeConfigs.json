{
  "name": "Banggood",
  "disableSec": false,
  "url": "https://m.banggood.com/en/search/{query}.html?currency=USD",
  "loadSelector": ".product-list",
  "loadWaitUntil": "domcontentloaded",
  "loadTimeout": 120000,
  "listIdentifier": ".product-list ul li",
  "singleItemLoadWaitUntil": "domcontentloaded",
  "singleItemTimeout": 120000,
  "singleItemPageWrapper": ".info-modular",
  "singleItemPageLoadSelector": ".info-modular",
  "singleItemPagePriceSelector": ".price",
  "singleItemPageNameSelector": ".products_name",
  "singleItemPageImageSelector": ".details-slide-img",
  "blockedResources": [
    "media",
    "font"
  ],
  "hrefHost": "https://m.banggood.com",
  "extractArgs": [
    {
      "keyName": "name",
      "selector": "p",
      "type": "text"
    },
    {
      "keyName": "price",
      "selector": ".price",
      "type": "price"
    },
    {
      "keyName": "image",
      "selector": "img",
      "type": "img"
    },
    {
      "keyName": "href",
      "selector": "a",
      "type": "href"
    }
  ]
}