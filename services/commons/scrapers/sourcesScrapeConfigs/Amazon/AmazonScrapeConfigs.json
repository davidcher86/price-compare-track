{
  "name": "Amazon",
  "disableSec": false,
  "url": "https://www.amazon.com/s?k={query}",
  "loadSelector": "#search",
  "loadWaitUntil": "domcontentloaded",
  "loadTimeout": 120000,
  "listIdentifier": "[data-asin][data-component-type=\"s-search-result\"]",
  "singleItemLoadWaitUntil": "domcontentloaded",
  "singleItemTimeout": 120000,
  "singleItemPageWrapper": "#centerCol",
  "singleItemPageLoadSelector": "#centerCol",
  "singleItemPagePriceSelector": ".a-price.aok-align-center",
  "singleItemPageNameSelector": "#value-pick-title-row",
  "singleItemPageImageSelector": "#imgTagWrapperId",
  "blockedResources": [
    "media",
    "font"
  ],
  "brightDataSupport" : true,
  "hrefHost": "https://www.amazon.com",
  "extractArgs": [
    {
      "keyName": "name",
      "selector": "h2 a span",
      "type": "text"
    },
    {
      "keyName": "price",
      "selector": ".a-price .a-offscreen",
      "type": "price"
    },
    {
      "keyName": "image",
      "selector": "img.s-image",
      "type": "img"
    },
    {
      "keyName": "href",
      "selector": "a[href]",
      "type": "href"
    }
  ]
}