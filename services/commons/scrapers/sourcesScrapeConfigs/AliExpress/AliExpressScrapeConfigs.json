{
  "name": "AliExpress",
  "brightDataSupport" : false,
  "url": "https://www.aliexpress.com/w/wholesale-{query}.html?spm=a2g0o.productlist.search.0",
  "loadSelector": "#card-list",
  "loadWaitUntil": "domcontentloaded",
  "loadTimeout": 120000,
  "disableSec": true,
  "listIdentifier": ".card-out-wrapper",
  "singleItemLoadWaitUntil": "domcontentloaded",
  "singleItemTimeout": 120000,
  "singleItemPageWrapper": "#product-details",
  "singleItemPageLoadSelector": "#product-details",
  "singleItemPagePriceTag": "#product-details",
  "blockedResources": [
    "media",
    "font"
  ],
  "extractArgs": [
    {
      "keyName": "name",
      "selector": "div[title]",
      "type": "text"
    },
    {
      "keyName": "price",
      "selector": "span[span:contains(\"$\")]",
      "type": "price"
    },
    {
      "keyName": "image",
      "selector": "a img[src]",
      "type": "img"
    },
    {
      "keyName": "href",
      "selector": "a.search-card-item",
      "type": "href"
    }
  ]
}