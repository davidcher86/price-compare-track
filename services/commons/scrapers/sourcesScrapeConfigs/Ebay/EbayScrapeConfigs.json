{
  "name": "Ebay",
  "url": "https://www.ebay.com/sch/i.html?_nkw={query}",
  "loadSelector": ".srp-results.srp-list",
  "loadWaitUntil": "domcontentloaded",
  "loadTimeout": 120000,
  "listIdentifier": "li.s-item, li.s-card",
  "singleItemLoadWaitUntil": "domcontentloaded",
  "singleItemTimeout": 120000,
  "singleItemPageWrapper": "#mainContent",
  "singleItemPageLoadSelector": "#mainContent",
  "singleItemPagePriceSelector": ".x-price-primary",
  "blockedResources": [
    "media",
    "font"
  ],
  "brightDataSupport" : false,
  "hrefHost": "https://www.ebay.com",
  "extractArgs": [
    {
      "keyName": "name",
      "selector": "[role=\"heading\"]",
      "type": "text"
    },
    {
      "keyName": "price",
      "selector": "span.s-item__price, span.s-card__price",
      "type": "price"
    },
    {
      "keyName": "image",
      "selector": ".s-item__image-wrapper img[src], .su-media__image a img[src]",
      "type": "img"
    },
    {
      "keyName": "href",
      "selector": ".s-item__image a, .su-media__image a",
      "type": "href"
    }
  ]
}