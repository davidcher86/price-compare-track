{
  "name": "NewEgg",
  "url": "https://www.newegg.com/p/pl?d={query}",
  "disableSec": true,
  "loadSelector": ".list-wrap",
  "loadWaitUntil": "domcontentloaded",
  "loadTimeout": 120000,
  "listIdentifier": ".item-cell",
  "singleItemLoadWaitUntil": "domcontentloaded",
  "singleItemTimeout": 120000,
  "singleItemPageWrapper": ".product-price",
  "singleItemPageLoadSelector": ".product-price",
  "singleItemPagePriceSelector": ".price-current",
  "blockedResources": [
    "media",
    "font"
  ],
  "brightDataSupport" : false,
  "hrefHost": "https://www.newegg.com",
  "extractArgs": [
    {
      "keyName": "name",
      "selector": ".item-title",
      "type": "text"
    },
    {
      "keyName": "href",
      "selector": "a[title='View Details']",
      "type": "href"
    },
    {
      "keyName": "price",
      "selector": ".price-current",
      "type": "price"
    },
    {
      "keyName": "image",
      "selector": ".item-container a img",
      "type": "img"
    }
  ]
}