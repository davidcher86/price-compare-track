{
  "name": "NewEgg",
  "url": "https://www.newegg.com/p/pl?d={query}",
  "disableSec": true,
  "loadSelector": ".list-wrap",
  "loadWaitUntil": "domcontentloaded",
  "loadTimeout": 120000,
  "listIdentifier": ".item-cell",
  "singleItemLoadWaitUntil": "domcontentloaded",
  "singleItemTimeout": 120000,
  "singleItemPageWrapper": "#product-details",
  "singleItemPageLoadSelector": "#product-details",
  "singleItemPagePriceTag": "#product-details",
  "blockedResources": [
    "media",
    "font"
  ],
  "brightDataSupport" : false,
  "hrefHost": "https://www.newegg.com",
  "extractArgs": [
    {
      "keyName": "name",
      "selector": ".item-title",
      "type": "text"
    },
    {
      "keyName": "href",
      "selector": ".item-open-box-italic",
      "type": "href"
    },
    {
      "keyName": "price",
      "selector": ".price-current",
      "type": "price"
    },
    {
      "keyName": "image",
      "selector": ".item-container a img",
      "type": "img"
    }
  ]
}