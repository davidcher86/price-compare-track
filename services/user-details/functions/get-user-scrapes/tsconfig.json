{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "../../",
    "sourceMap": true,
    "outDir": "./dist",
    "declaration": false,
    "noEmitOnError": true,
    "incremental": true, 
    "noEmit": true,
    "paths": {
      "@shared-commons/*": ["../commons/*"]
    }
  },
  "include": ["../commons/**/*.ts", "./*.ts", "../*.ts", "./*.json", "../*.json"],
  "exclude": []
}