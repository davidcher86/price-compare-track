{
  "name": "user-details",
  "version": "1.0.0",
  "description": "<!-- title: 'AWS NodeJS Example' description: 'This template demonstrates how to deploy a simple NodeJS function running on AWS Lambda using the Serverless Framework.' layout: Doc framework: v4 platform: AWS language: nodeJS priority: 1 authorLink: 'https://github.com/serverless' authorName: 'Serverless, Inc.' authorAvatar: 'https://avatars1.githubusercontent.com/u/13742415?s=200&v=4' -->",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "invoke:handle-scrape-request": "sls invoke local -f acceptRequest --stage prod --path functions/get-user-scrapes/mock-data/datamockhttp.json",
    "invoke:get-scrape-data-result": "sls invoke local -f get-scrape-data-result --stage prod --path functions/get-scrape-result/mock-data/datamockhttp.json",
    "offline:user-details": "serverless offline --config serverless-user-details.yml",
    "deploy-user-details": "serverless deploy --config serverless-user-details.yml",
    "seed:dynamo": "node scripts/initDynamo.js",
    "debug": "node --inspect node_modules/.bin/serverless offline",
    "initDynamo": "node scripts/initDynamo.js",
    "puppeteer": "sls invoke local -f scrape-puppeteer --path functions/puppeteer/datamock.json",
    "playwright": "sls invoke local -f scrape-playwright --path functions/playwright/datamock.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.846.0",
    "@aws-sdk/client-dynamodb": "^3.846.0",
    "@aws-sdk/lib-dynamodb": "^3.846.0",
    "@types/node": "^22.14.1",
    "serverless": "^4.17.1",
    "serverless-offline": "^14.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
