{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "../../../",
    "sourceMap": true,
    "outDir": "./dist",
    "declaration": false,
    "noEmit": true,
    "noEmitOnError": true,
    "incremental": true
  },
  "paths": {
    "@shared-commons/*": ["../../../../commons/**"]
  },
  "include": [
    "./*.ts", 
    "../../../../../layers/**/*.ts", 
    "./../*.ts", 
    "../../../commons/*.ts", 
    "../../../../../commons/**/*.ts",
    "../../commons/**/*.ts"
  ],
  "exclude": []
}