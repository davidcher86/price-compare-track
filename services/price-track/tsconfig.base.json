{
  "compilerOptions": {
    "target": "ES2020",
    "strict": true,
    "rootDir": "../",
    "baseUrl": "./",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noEmitOnError": true,
    "incremental": true,
    "moduleResolution": "Node",
    "module": "CommonJS",
    "resolveJsonModule": true
  },
  "paths": {
    "@commons/*": ["commons/**"],
    "@shared-commons/*": ["../commons/**"],
    "@price-track-commons/*": ["commons/**"]
  },
  "include": ["./**/*.ts", 
              "../../layers/**/*.ts", 
              "functions/add-price-track/**/*.ts", 
              "functions/delete-price-track/**/*.ts", 
              "functions/update-price-track/**/*.ts", 
              "commons/**/*.ts",
              "../commons/**/*.ts"]
}