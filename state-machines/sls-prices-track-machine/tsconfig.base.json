{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "outDir": ".build",
    "strict": true,
    "types": ["node", "aws-lambda"],
    "skipLibCheck": true
  },
  "include": [
    "handlers/get-scrape-list/**/*.ts",
    "handlers/extract-data/**/*.ts",
    "handlers/scrape-site/**/*.ts",
    "handlers/update-price-track/**/*.ts"
  ]
}
